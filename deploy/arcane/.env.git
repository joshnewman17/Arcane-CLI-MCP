# Non-secret defaults, merged by Arcane into the project's .env (values set in Arcane win).
# Set these in the Arcane UI project .env instead of committing them:
#   ARCANE_URL=https://<your-arcane-host>
#   ARCANE_API_KEY=<scoped API key>
#   MCP_AUTH_TOKEN=<openssl rand -hex 32>
ARCANE_DEFAULT_ENV=0
ARCANE_MCP_READONLY=false
MCP_HOST_PORT=8090
