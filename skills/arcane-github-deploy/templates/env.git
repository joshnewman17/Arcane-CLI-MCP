# deploy/arcane/.env.git: NON-secret defaults only. Arcane merges this into the project .env
# (values set in Arcane win), but only when it is synced; the default sync copies just the
# compose file, so also give every variable a default in compose with ${VAR:-default}.
#
# Secrets go in the Arcane UI: Projects -> <project> -> .env
HOST_PORT=8090
