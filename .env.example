# --- Required ---------------------------------------------------------------
# Arcane instance URL as seen from the arcane-cli-mcp container.
ARCANE_URL=http://192.168.1.10:3552
# API key of a scoped, NON-admin Arcane user (Settings -> API Keys).
ARCANE_API_KEY=arc_replace_me
# Alternatively read the key from a file (e.g. a Docker secret):
# ARCANE_API_KEY_FILE=/run/secrets/arcane_api_key

# --- MCP endpoint -------------------------------------------------------------
# Bearer token required on every MCP request. Generate one with: openssl rand -hex 32
MCP_AUTH_TOKEN=replace_with_a_long_random_string
# MCP_HOST=0.0.0.0
# MCP_PORT=8080
# Path of the MCP endpoint (default /mcp).
# MCP_PATH=/mcp

# Cloudflare Access mode (instead of MCP_AUTH_TOKEN): set both to require a valid Access JWT.
# CF_ACCESS_TEAM_DOMAIN=myteam
# CF_ACCESS_AUD=<Access application AUD tag>

# --- Behaviour ----------------------------------------------------------------
ARCANE_DEFAULT_ENV=0
ARCANE_MCP_READONLY=false
# MAX_OUTPUT_CHARS=40000
# DEFAULT_TIMEOUT_S=120
# LONG_TIMEOUT_S=1800
# Set to false only if Arcane uses a self-signed certificate (affects arcane_api_get).
# ARCANE_VERIFY_TLS=true

# --- Self-protection ------------------------------------------------------------
# Restart/stop/update of these returns self_target=true unless confirm=true AND allow_self=true.
# SELF_PROJECT=arcane-cli-mcp
# SELF_CONTAINERS=arcane-cli-mcp,arcane-cli-mcp-tunnel
# SELF_ENV=0
